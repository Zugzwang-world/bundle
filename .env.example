# Local dev: copy to .env. Vite inlines VITE_* into the client bundle, so a build made with
# this key must never be deployed. The deployed site uses the Netlify function at /api/messages
# instead, which reads ANTHROPIC_API_KEY from the Netlify environment.
VITE_ANTHROPIC_API_KEY=
VITE_MODEL=claude-fable-5-1
VITE_EMBED_MODEL=Xenova/all-MiniLM-L6-v2
